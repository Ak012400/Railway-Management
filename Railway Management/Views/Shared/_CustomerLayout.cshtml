@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="/resources/demos/style.css">
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.js"></script>
    <script>

    </script>

    <style>
        /* General Styles */
        body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: -webkit-gradient();
        color:blue;
        }

        header {
        background-color: #2F4F4F;
        color: #fff;
        padding: 10px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        }

        .header-left {
        font-size: 24px;
        font-weight: bold;
        }

        .header-right {
        display: flex;
        align-items: center;
        gap: 20px;
        }

        .header-right a {
        text-decoration: none;
        color: white;
        font-size: 16px;
        padding: 8px 16px;
        border: 1px solid white;
        border-radius: 5px;
        transition: background-color 0.3s;
        }

        .header-right a:hover {
        background-color: #fff;
        color: #2F4F4F;
        }

        .banner {
            background-color: #004E8C;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 33px;
            margin-top: 270px;
            width: 100%;
        }

        .microsoft-logo {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1px;
        }

        .square {
            width: var(--size, 10px);
            height: var(--size, 10px);
        }

        .red {
            background-color: #F25022;
        }

        .green {
            background-color: #7FBA00;
        }

        .blue {
            background-color: #00A4EF;
        }

        .yellow {
            background-color: #FFB900;
        }

        .brand-name {
            color: white;
            font-size: 15px;
            font-weight: 500;
            margin-left: 5px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        .copyright {
            color: white;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            margin-left: 66%;
        }
    </style>
</head>
<body>
    <header>
        <div class="header-left">
            Railway Management
        </div>
        <div class="header-right">
            <a href="@Url.Action("CustomerMainPage", "Customers")" id="logoutButton">Home</a>
            @if (User.Identity.Name != null)
            {
                <img src="~/uploads/@User.FindFirst("userprofile")?.Value" alt="userImage" style="width:60px;height:60px;border:2px solid;border-radius:30px;" />
                <a href="@Url.ActionLink("CustomerDetails","Customers")">Welcome @User.Identity.Name</a>
                <a href="@Url.ActionLink("Logout","Customers")">Logout</a>
               
            }
            
        </div>
    </header>

    <!-- Main Content Area -->
    <div>
        @RenderBody()
    </div>

    <div class="modal fade" id="custom_Alert" role="dialog" style="align-self:center;transition:0.5s ease">
        <div class="modal-content align-content-center">
            <div class="modal-header align-content-center">
                <p align="center">Alert</p>
                <button type="button" class="btn-close" data-modal="dismiss" id="crossAlert"></button>
            </div>
            <div class="modal-body align-content-center">
                <h5 id="messageAlert"></h5>
            </div>
            <div class="modal-footer" style="padding:30px;color:gray">
                <button type="button" class="btn btn-primary" id="btnClose" style="outline:none;padding:5px;width:10px">Close</button>
            </div>
        </div> 
    </div>


    <footer>
        <div class="banner">
            <div class="microsoft-logo" align="left">
                <div class="square red"></div>
                <div class="square green"></div>
                <div class="square blue"></div>
                <div class="square yellow"></div>
            </div>
            <div class="brand-name">Microsoft</div>
            <div class="copyright" align="right">&copy; Microsoft Corporation. All rights reserved.</div>
        </div>
    </footer>
</body>
</html>
