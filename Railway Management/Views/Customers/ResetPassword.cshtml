@{
    Layout = "_Layout";
}
<style>
    .error{
        outline:none;
        color:red
    }
</style>

<div class="container" id="forgotPasswordmodal" style="align-content:center;background-color:burlywood;margin-left:50px;display:flex">
    <div class="container-lg" style="align-items:center;flex:auto">
        <div class="container-md align-content-center">
            <div class="mb-auto">
                <label for="lblnewPassword" name="lblnewPassword" id="lablefornewpassword">NewPassword<span style="color:red">*</span> </label>
                <input type="password" id="newpassword" name="newpassword" style="border:1px solid;border-radius:5px;padding:10px" />
            </div>
            <div class="mb-auto">
                <label for="lblconfirmPassword" name="lblconfirmpassword" id="lblconfirmpassword">ConfirmPassword<span style="color:red">*</span></label>
                <input type="password" id="confirmpassword" name="confirmpassword" style="border:1px solid;border-radius:5px;padding:10px" />
            </div>
            <div class="mb-auto">
                <button type="button" class="btn btn-primary" id="submitpassword" align="center">Submit</button>
                <span id="errormessage"style="color:red"></span>
            </div>
        </div>
    </div>
</div>
<div class="modal" align="center" id="loadermodal">
    <div class="modal-dialog">
        <div class="modal-body">
            <img src="~/images/loader.gif" />
        </div>
    </div>
</div>
<script>
    $(document).ready(function(){
    
        $('#newpassword').on('keyup',function(){
          const value=$('#newpassword').val();
          if(/[a-z]/.test(value) && /[A-Z]/.test(value) && /[\W_]/.test(value) && /[0-9]/.test(value) && value.length>=9){
              $('#newpassword').removeClass('error');
              $('#submitpassword').show();
              $('#errormessage').text('');
          }
          else{
              $('#newpassword').addClass('error');
              $('#submitpassword').hide();
              $('#errormessage').text('Please Include Your Password with All Possible combination with atleast 9 charrctor');
          }
        
        });
        $('#confirmpassword').on('keyup',function(){
          const value=$('#confirmpassword').val();
          if(/[a-z]/.test(value) && /[A-Z]/.test(value) && /[\W_]/.test(value) && /[0-9]/.test(value) && value.length>=9){
              $('#confirmpassword').removeClass('error');
              $('#submitpassword').show();
              $('#errormessage').text('');
          }
          else{
              $('#confirmpassword').addClass('error');
              $('#submitpassword').hide();
              $('#errormessage').text('Please Include Your Password with All Possible combination with atleast 9 charrctor');
          }

        });

        $('#submitpassword').on('click',function(){

            const newPassword=$('#newpassword').val();
            const confirmPassword=$('#confirmpassword').val();
            if(newPassword !=confirmPassword){
                $('#errormessage').text('NewPassword and ConfirmPassword Are Not Matching');
                return false;
            }
            $('#loadermodal').show()
            $.post('/Customers/ResetPassword',{
               Password:newPassword,
            },function(message,status){
                if(message.status==200){
                    $('#loadermodal').hide();
                    alert(message.message);
                }
                else{
                    $('#loadermodal').hide();
                     alert(message.message);
                }
              
            }).fail(function(){
                $('#loadermodal').hide();
              alert('There is some Technical Issue happend');
            })
        });



    
    });


</script>