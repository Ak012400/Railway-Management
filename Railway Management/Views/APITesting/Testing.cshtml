@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Learning JQUERY</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="/resources/demos/style.css">
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.js"></script>
</head>
<body>
    <div class="container" align="center">
        <div class="row row-1">
            <h1>Please Input Your Field To Get Data</h1>
        </div>
        <div class="accordion-body">
            <div class="col-1 flex-column">
                <label for="customers" id="cu">Input Name:</label>
                <input type="text" id="Customers" name="customers" />
                <label for="senddata" id="send">SendData</label>
                <input type="text" id="senddata" />
                <input type="button" id="submit" class="btn btn-primary" value="Submit"/>
            </div>
            <div class="accordion-item" id="customerList" style="height: 300px;width:auto; overflow-y: scroll; border: 1px solid #ccc;">
                
            </div>
        </div>

    </div>


    <script>
        $(document).ready(function(){
        
            $('#Customers').on("input",function(){
                  $.get("/APITesting/GetData", function(data, status){
                      data.forEach(customer=>{
                          const existingDiv=$(`#customer-${customer.customerID}`);
                          if(existingDiv.length===0){
                              const customerdiv=`
                               <div id="customer-${customer.customerID}" class="customer-card">
                               <p><strong>Name</strong>${customer.name}</p>
                               <p><strong>Email</strong>${customer.email}</p>
                               
                               </div>
                              `;
                               $('#customerList').append(customerdiv);
                          }
                         
                      });
                     
                  });
            });

            $('#submit').on('click', function(){
                    const val1=$('#senddata').val();
                    $.post("/APITesting/PostData",{
                        value:val1
                    },function(data,status){

                       alert(data.message);

                    })
            });

        });

    </script>
    
    

</body>
</html>
